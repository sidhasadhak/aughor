# Copy to .env.local (gitignored) and fill in. `npm run dev` loads it via --env-file.

# ── Slack app (Socket Mode) ─────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...        # App-Level Token with connections:write

# Slack's Agent messaging: progress cards and the native stop button. Set to 1
# ONLY once the app has the Agents & AI Apps feature and the assistant:write
# scope (see README) — turning it on against an app without them costs the
# final message of every answer.
# SLACK_AGENT_VIEW=1

# ── The running Aughor API (same names the MCP client uses) ──────────────────
AUGHOR_API_URL=http://127.0.0.1:8000
# AUGHOR_API_KEY=               # sent as X-Api-Key when the API enforces one
AUGHOR_CONNECTION_ID=workspace  # the connection questions run against

# Where "Open in Aughor →" points. Unset, answers carry no link.
AUGHOR_WEB_URL=http://localhost:3000

# ── Diagnostics ─────────────────────────────────────────────────────────────
# debug also prints the adapter's streaming decisions ("using fallback stream").
# LOG_LEVEL=debug

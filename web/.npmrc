# Supply-chain damper: never resolve a package version published less than 7 days
# ago (npm >= 11.10; older npm silently ignores the key). This protects the place
# where NEW versions actually enter the tree — a developer's `npm install`/`npm
# update` (local npm is 11.11 as of 2026-08-08). CI is unaffected either way: its
# node 20 ships npm 10, and `npm ci` installs the committed lockfile verbatim
# without resolving anything new.
min-release-age=7

{"id": "s01_order_count", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "n", "agg": "count"}]}}
{"id": "s02_total_revenue", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "revenue", "metric": "revenue", "decimals": 2}]}}
{"id": "s03_cancelled_count", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "status", "value": "cancelled"}], "measures": [{"name": "n", "agg": "count"}]}}
{"id": "s04_cancellation_rate", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "cancelled_pct", "agg": "count", "where": [{"path": "status", "value": "cancelled"}], "divide_by": {"agg": "count"}, "scale": 100, "decimals": 2}]}}
{"id": "s05_active_orders", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "status", "op": "not_in", "values": ["delivered", "cancelled", "refunded"]}], "measures": [{"name": "open_orders", "agg": "count"}]}}
{"id": "s06_revenue_by_category", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order_item", "by": ["product.category"], "measures": [{"name": "revenue", "agg": "sum", "path": "line_total", "decimals": 2}]}}
{"id": "s07_orders_per_category", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order_item", "by": ["product.category"], "measures": [{"name": "orders", "agg": "count_distinct", "path": "order_id"}]}}
{"id": "s08_aov_delivered", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "segment": "delivered_orders", "measures": [{"name": "delivered_aov", "agg": "avg", "path": "total_amount", "decimals": 2}]}}
{"id": "s09_spend_by_country", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "by": ["customer.country"], "measures": [{"name": "revenue", "agg": "sum", "path": "total_amount", "decimals": 2}]}}
{"id": "s10_avg_rating_by_category", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "review", "by": ["order_item.product.category"], "measures": [{"name": "avg_rating", "agg": "avg", "path": "rating", "decimals": 2}]}, "note": "reviews attach to ORDERS and an order carries several products — the measured link review↔order_item is N:N, so the compiler refuses the only path the graph offers"}
{"id": "s11_items_per_order", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "order_item", "op": "exists"}], "measures": [{"name": "lines_per_order", "agg": "count", "path": "order_item", "divide_by": {"agg": "count"}, "decimals": 3}]}}
{"id": "s12_review_coverage", "dataset": "evals/ablation_samples_ecommerce.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "review_coverage", "agg": "count", "where": [{"path": "review", "op": "exists"}], "divide_by": {"agg": "count"}, "decimals": 4}]}, "note": "the builder never linked reviews to orders (it linked them to customers and, N:N, to order items)"}
{"id": "l01_orders_per_category", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order_item", "by": ["category"], "measures": [{"name": "orders", "agg": "count_distinct", "path": "order_id"}, {"name": "item_revenue_eur", "agg": "sum", "path": "unit_price_eur", "decimals": 2}]}}
{"id": "l02_returned_line_share", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order_item", "measures": [{"name": "returned_line_pct", "agg": "count", "where": [{"path": "returned", "value": "true"}], "divide_by": {"agg": "count"}, "scale": 100, "decimals": 2}]}}
{"id": "l03_cancelled_pct", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "cancelled_pct", "agg": "count", "where": [{"path": "status", "value": "cancelled"}], "divide_by": {"agg": "count"}, "scale": 100, "decimals": 2}]}}
{"id": "l04_returned_gmv_share", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "returned_gmv_share_pct", "agg": "sum", "path": "gmv_eur", "where": [{"path": "status", "value": "returned"}], "divide_by": {"agg": "sum", "path": "gmv_eur"}, "scale": 100, "decimals": 2}]}}
{"id": "l05_shipping_cost_share", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "shipment", "measures": [{"name": "shipping_cost_pct", "agg": "sum", "path": "shipping_cost_eur", "divide_by": {"agg": "sum", "path": "order.gmv_eur"}, "scale": 100, "decimals": 2}]}, "note": "the builder linked shipments only to order items; the pack's expected claim shipments→orders is the missing edge"}
{"id": "l06_gmv_with_returns", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "order_item.returned", "value": "true"}], "measures": [{"name": "gmv_eur", "agg": "sum", "path": "gmv_eur", "decimals": 2}]}, "note": "the reference reads the returns table; the graph offers the returned flag on the order's lines — a different witness for the same fact, scored like any answer"}
{"id": "l07_rejected_returns", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "return_logistic", "segment": "reject_returnlogistics", "measures": [{"name": "rejected_returns", "agg": "count"}]}}
{"id": "l08_item_revenue_by_channel", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order_item", "by": ["order.channel"], "measures": [{"name": "item_revenue_eur", "agg": "sum", "path": "unit_price_eur", "decimals": 2}]}}
{"id": "l09_never_shipped", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "shipment", "op": "not_exists"}], "measures": [{"name": "never_shipped", "agg": "count"}]}, "note": "no orders↔shipments link in the built graph (the same missing edge as l05)"}
{"id": "l10_cs_coverage", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "ticket_coverage", "agg": "count", "where": [{"path": "order_item.customer_service", "op": "exists"}], "divide_by": {"agg": "count"}, "decimals": 4}]}, "note": "orders↔tickets is N:N on customer_id in the graph; the order's lines carry the ticket's order_id, so the semi-join goes through them"}
{"id": "l11_customers_with_orders", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "measures": [{"name": "customers_with_orders", "agg": "count_distinct", "path": "customer_id"}]}}
{"id": "l12_avg_retail_price_by_category", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "product", "by": ["category"], "measures": [{"name": "avg_retail_price_eur", "agg": "avg", "path": "retail_price_eur", "decimals": 2}]}}
{"id": "l13_aov_and_items_by_platform", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "order", "filters": [{"path": "order_item", "op": "exists"}], "by": ["platform"], "measures": [{"name": "aov_eur", "agg": "avg", "path": "gmv_eur", "decimals": 2}, {"name": "items_per_order", "agg": "count", "path": "order_item", "divide_by": {"agg": "count"}, "decimals": 3}]}}
{"id": "l14_captured_by_method", "dataset": "evals/ablation_luxexperience_hard.jsonl", "object_query": {"object_type": "payment", "filters": [{"path": "status", "value": "captured"}], "by": ["payment_method"], "measures": [{"name": "captured_eur", "agg": "sum", "path": "amount_eur", "decimals": 2}]}}

*.egg-info/
.venv/
dist/
.env

# uv
.python-version

# Data & secrets
data/connections.db
# The serving process's pid marker (db/serving.py). Runtime state of ONE machine —
# meaningless anywhere else, and this repo is public.
data/.serving.pid
data/.hermes_key
data/.aughor_key
data/hermes.duckdb
data/aughor.duckdb
data/samples.duckdb
data/history.db
data/checkpoints.db
data/checkpoints.db-shm
data/checkpoints.db-wal
data/connection_settings.json
data/exploration_*.json
data/episodes_*.jsonl
# Ontology docs are REBUILT per run (the yaml carries a `built_at` stamp and a
# per-run checksum), so a dev server writing them is not a change anyone wants to
# review. The governed ontology artifacts a reviewer SHOULD see are
# data/ontology_overrides/ and data/context_graph/, which stay tracked.
data/ontology_docs/
# Those two stay tracked for the connections a reviewer can NAME — workspace, samples,
# aughor_ops — which is exactly what is committed today. What is not reviewable is the
# same artifact written for a connection that exists only on one machine: a registered
# connection gets an 8-hex-character id, and its context graph and column config are
# then generated by whoever happened to open it. Ignored by that id shape rather than by
# directory, so a new artifact for a NAMED connection still shows up and still gets
# reviewed — a blanket ignore here would hide the governed files this comment protects.
data/context_graph/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
data/ontology_column_config/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
data/ontology_cache.json
data/schema_cache.json
data/schema_profiles.json
data/audit.db
data/canvases.db
data/evidence_ledger.db
data/monitors.db
data/mat_cache.duckdb
data/sync_state_*.json
data/api_sync/
data/uploads/
data/smoke_*.json
# The glossary is stored in TWO files, split by the `auto_generated` marker that already drove
# its merge precedence (see aughor/semantic/glossary.py):
#   data/glossary.yaml            — hand-authored terms. TRACKED, and now small enough to review.
#   data/glossary_generated.yaml  — the ontology autodoc's per-table output. Ignored below.
# The autodoc appends an entry per table whenever a connection is explored, so before the split
# merely RUNNING the app rewrote a tracked file (1,435 lines from one session on 2026-07-24) and
# buried four real analyst notes in the churn. Tests were never the cause — conftest points
# AUGHOR_GLOSSARY_PATH at a throwaway temp copy, and the sidecar follows it automatically.
data/glossary_generated.yaml

# Claude Code internal state
.claude/

# Duplicate runtime data under web/
web/data/

# macOS
.DS_Store

# Node
web/node_modules/
web/.next/
web/.env.local

# IDEs
.idea/
.vscode/

# Generated workspace data
data/*.db
data/*.json
data/*.duckdb
# SQLite WAL sidecars — every store now opens in WAL mode (REC-03), so any
# data/*.db can spawn -wal/-shm/-journal companions. Transient; never version.
data/*.db-wal
data/*.db-shm
data/*.db-journal
# DuckDB write-ahead logs / sidecars (transient — never version these)
data/*.duckdb.wal
data/*.duckdb-wal
data/*.duckdb.tmp
*.duckdb.wal

# Eval run artifacts (regenerable — durable outputs are the dataset/harness/FINDINGS)
evals/results*.json
evals/_log*.txt
data/system.db
data/system.db-shm
data/system.db-wal
# Recovery artifacts from a corrupt ledger (2026-08-14): `sqlite3 .recover` leaves a
# `.corrupt.bak` of the original and a `.lost_and_found.sql` of rows it could not
# attribute to a table. Both contain ledger CONTENT — investigation questions, SQL text,
# artifact payloads — and this repository is PUBLIC, so a stray `git add -A` would
# publish them. The three tracked artifact directories under data/ (context_graph,
# ontology_docs, ontology_column_config, ontology_overrides) are unaffected: this
# pattern only matches the system.db family.
data/system.db.*

# Runtime/session artifacts — auto-created backups from platform resets, purges and
# quarantines; runtime finding-dismissal state; and eval output dumps. All disposable
# or regenerable, none belong in the repo. (data/*.json already covers profile/exploration.)
data/_*backup*/
data/_stale_findings_backup_*/
data/finding_dismissals.jsonl
data/ontology_recommendations/
# NOTE: FOUR data/ paths are deliberately NOT ignored, because each store's own
# docstring declares it a version-controllable artifact rather than runtime state:
#   data/ontology_overrides/     the human override overlay        (overrides.py)
#   data/context_graph/          the Wave-C knowledge graph        (context_graph_store.py)
#   data/ontology_docs/          the R8 Merkle doc tree            (doctree.py: "git-reviewable")
#   data/ontology_column_config/ the R11 per-column config         (column_config.py)
# A nested json/yaml escapes the non-recursive data/*.json rule on purpose, so these
# can be reviewed in a diff and shipped to a teammate. Adding any of them here once
# silently negated Waves C and E4 (PR #218) — read the store's docstring first.
# To keep a PRIVATE connection's artifacts out of a public repo, point the store
# elsewhere instead of ignoring it: AUGHOR_ONTOLOGY_DOCS_DIR / AUGHOR_COLUMN_CONFIG_ROOT.
evals/spider2_out/
evals/bakeoff_out/
evals/spider2_afix/
evals/spider2_cand/
evals/spider2_cand_full/
evals/spider2_proj/
evals/spider2_misses_proj/
evals/spider2_probes_smoke/
evals/spider2_*_run.log
evals/lsb_out/
evals/llm_exp/
/agents.db*

# Wave O1 — per-connection vocabulary (synonyms, formats, value dictionaries).
# TRACKED deliberately: a synonym is governed curation a reviewer should see in a diff,
# same as data/ontology_overrides/. Listed here only to document that it is NOT ignored.
!data/vocabulary/

# DuckDB spills temp storage here during test runs — never commit it.
.tmp/

# Vercel CLI link state (machine-local project/org ids)
.vercel/
.vercel
.env*
.vercelignore
.env.local

# Imported skill packs — third-party prose brought in by `aughor skills import`.
# Untracked on purpose: this repo is public, and redistributing a skill library inside
# it is a deliberate decision, not a side effect of running an importer.
data/packs/
